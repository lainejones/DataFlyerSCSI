; RunTests - DriveTests from an icon: pick a scratch drawer, pick Quick or
; Full, and the three tools run in turn with their logs in that drawer.
; Double-click RunTests (IconX runs this), or in a Shell:
;   Execute RunTests [DIR] [Quick|Full] [SKIPIDS=<id,id>] [AMIDEFRAG]
; (drawer and mode are asked for when left out; SKIPIDS names SCSI ids
; flysuite must not touch - a network adapter on the bus, e.g. a DaynaPORT;
; AMIDEFRAG also runs the AmiDefrag 0.3 block-map analysis, which is off by
; default: in our tests it rebooted the machine when it exited)
.KEY DIR,MODE,SKIPIDS/K,AMIDEFRAG/S
.BRA {
.KET }
FailAt 21
CD ""
; unpacked on a PC and copied over, the tools arrive without their
; executable bit: put it back before anything else
Protect flysuite +e
Protect AmiFSX +e
Protect AmiDefrag +e
Protect volunit +e

If "{DIR}" EQ ""
  RequestFile >ENV:dt_dir DRAWERSONLY TITLE "DriveTests: a SCRATCH drawer on the drive to test" NOICONS
  If WARN
    Echo "No drawer picked - nothing done."
    Quit 5
  EndIf
Else
  Echo >ENV:dt_dir "{DIR}"
EndIf
; RequestFile quotes the name
Set dt_dir `Type ENV:dt_dir`
Set dt_dir ${dt_dir}

volunit "${dt_dir}" VAR=dt_unit VOLVAR=dt_vol
If "{SKIPIDS}" EQ ""
  Set dt_skip ""
Else
  Set dt_skip "SKIPIDS={SKIPIDS}"
EndIf
If WARN
  If "{MODE}" EQ ""
    RequestChoice >NIL: "DriveTests" "${dt_dir} is not on a disk device (RAM:, a network share?).*NPick a drawer on the drive you want to test." "OK"
  EndIf
  Quit 20
EndIf

If "{MODE}" EQ "Full"
  Set dt_mode 1
Else
  If "{MODE}" EQ "Quick"
    Set dt_mode 2
  Else
    RequestChoice >ENV:dt_mode "DriveTests" "Drive: ${dt_unit}*NScratch drawer: ${dt_dir}*N*NQuick reads only and writes nothing.*NFull also writes test files in that drawer*N(made, checked and deleted again) and runs AmiFSX.*N*NEverything is logged in the drawer." "Full|Quick|Cancel"
    Set dt_mode `Type ENV:dt_mode`
  EndIf
EndIf
If "${dt_mode}" EQ "0"
  Echo "Cancelled."
  Quit 5
EndIf

Echo ""
Echo "DriveTests: ${dt_unit}, scratch drawer ${dt_dir}"
Echo "----------------------------------------------------------------"
Echo "1/3  flysuite - the driver"
If "${dt_mode}" EQ "1"
  flysuite ${dt_unit} ${dt_skip} TESTS=all MINUTES=2 WRITEFILE="${dt_dir}" LOG="${dt_dir}/flysuite.log"
Else
  flysuite ${dt_unit} ${dt_skip} TESTS=conf,big,edge,dma16,latency,audit LOG="${dt_dir}/flysuite.log"
EndIf
Set dt_rc1 $RC
Echo ""
If "${dt_mode}" EQ "1"
  Echo "2/3  AmiFSX - the files (20000 operations)"
  AmiFSX "${dt_dir}/fsxtest" N=20000 P=2000 C=100 XREAD >"${dt_dir}/amifsx.log"
  Set dt_rc2 $RC
  Type "${dt_dir}/amifsx.log"
Else
  Echo "2/3  AmiFSX skipped (Quick: no writes)"
  Set dt_rc2 0
EndIf
Echo ""
If "{AMIDEFRAG}" EQ ""
  Echo "3/3  AmiDefrag skipped (0.3 rebooted the machine on exit in our tests;"
  Echo "     AMIDEFRAG runs it anyway, or by hand: AmiDefrag ${dt_vol} MAP WIDTH=72)"
  Set dt_rc3 0
Else
  Echo "3/3  AmiDefrag - the structures on disk (analyse only)"
  ; the volume of the scratch drawer, e.g. "Work:" from "Work:tests"
  AmiDefrag ${dt_vol} MAP WIDTH=72 >"${dt_dir}/amidefrag.log"
  Set dt_rc3 $RC
  Type "${dt_dir}/amidefrag.log"
EndIf
Echo ""
Echo "----------------------------------------------------------------"
Echo "flysuite rc ${dt_rc1}  (0 passed, 5 a FAIL, 10 a HANG)"
Echo "AmiFSX   rc ${dt_rc2}  (0 passed, 10 a mismatch)"
Echo "AmiDefrag rc ${dt_rc3}"
Echo "Logs: ${dt_dir}/flysuite.log, amifsx.log, amidefrag.log"
; a requester only when the script asked its questions (icon use); from a
; Shell with the answers on the line it just ends, so scripts can run it
If "{MODE}" EQ ""
  RequestChoice >NIL: "DriveTests" "Done.*N*Nflysuite rc ${dt_rc1}, AmiFSX rc ${dt_rc2}, AmiDefrag rc ${dt_rc3}*N(0 = passed)*N*NThe logs are in ${dt_dir}.*NPlease post flysuite.log with any report." "OK"
EndIf
UnSet dt_dir
UnSet dt_unit
UnSet dt_mode
UnSet dt_vol
UnSet dt_skip
